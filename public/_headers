# Security + caching headers (Netlify / Cloudflare Pages format, alongside
# _redirects). Browsers and security scanners check for these; missing
# ones are a common "is this site trustworthy?" red flag.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Vite fingerprints everything under /assets with a content hash, so these
# files never change at a given URL and can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
